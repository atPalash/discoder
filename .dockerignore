# Version control
.git
.gitignore

# Kiro spec/workflow files — not needed at runtime
.kiro

# Python caches and build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test, coverage, and property-test caches
tests/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Tooling / IDE / OS noise
.mypy_cache/
.ruff_cache/
.vscode/
.idea/
*.swp
.DS_Store

# Local environment and secrets — must never be baked into the image
.env
*.env
*.local

# Docs and container files (don't need to be in build context)
Dockerfile
.dockerignore
